# ═══════════════════════════════════════════════════════════════
# SERVEUR HTTP AVEC ROUTES API
# ═══════════════════════════════════════════════════════════════

generate_server() {
cat > "$BASE/server.py" << 'SERVEREOF'
#!/usr/bin/env python3
import http.server
import socketserver
import json
import os
import sys
import subprocess
import urllib.request
import urllib.parse
import ssl
import hashlib
from pathlib import Path

PORT = int(sys.argv[1])
BASE = Path("/tmp/bluenexus")
PAGES = BASE / "pages"

SSL_CTX = ssl.create_default_context()
SSL_CTX.check_hostname = False
SSL_CTX.verify_mode = ssl.CERT_NONE

def bsky_get(path):
url = "https://public.api.bsky.app" + path
try:
req = urllib.request.Request(url, headers={
"User-Agent": "BlueNexus/2.0",
"Accept": "application/json"
})
with urllib.request.urlopen(req, timeout=10, context=SSL_CTX) as r:
return json.loads(r.read().decode("utf-8"))
except Exception as e:
return {"error": str(e)}


class Handler(http.server.BaseHTTPRequestHandler):
def log_message(self, *a): pass

def _json(self, data, code=200):
body = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", "application/json; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
try: self.wfile.write(body)
except: pass

def _html(self, path, code=200):
if not path.exists():
self.send_response(404); self.end_headers(); return
body = path.read_bytes()
self.send_response(code)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
try: self.wfile.write(body)
except: pass

def _css(self, path):
if not path.exists():
self.send_response(404); self.end_headers(); return
body = path.read_bytes()
self.send_response(200)
self.send_header("Content-Type", "text/css; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
try: self.wfile.write(body)
except: pass

def do_GET(self):
path = urllib.parse.urlparse(self.path).path
qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)

# CSS
if path == "/style.css":
return self._css(PAGES / "style.css")

# Pages HTML
if path == "/" or path == "/index.html":
return self._html(PAGES / "index.html")
if path == "/profile.html":
return self._html(PAGES / "profile.html")
if path == "/search.html":
return self._html(PAGES / "search.html")
if path == "/trending.html":
return self._html(PAGES / "trending.html")
if path == "/about.html":
return self._html(PAGES / "about.html")

# API profil
if path == "/api/profile":
actor = qs.get("actor", ["bsky.app"])[0]
data = bsky_get(f"/xrpc/app.bsky.actor.getProfile?actor={urllib.parse.quote(actor)}")
return self._json(data)

# API feed
if path == "/api/feed":
actor = qs.get("actor", ["bsky.app"])[0]
limit = qs.get("limit", ["20"])[0]
data = bsky_get(f"/xrpc/app.bsky.feed.getAuthorFeed?actor={urllib.parse.quote(actor)}&limit={limit}")
return self._json(data)

# API suggestions
if path == "/api/suggestions":
data = bsky_get("/xrpc/app.bsky.actor.getSuggestions?limit=25")
return self._json(data)

# API recherche acteurs
if path == "/api/search/actors":
q = qs.get("q", [""])[0]
data = bsky_get(f"/xrpc/app.bsky.actor.searchActors?q={urllib.parse.quote(q)}&limit=25")
return self._json(data)

# API recherche posts
if path == "/api/search/posts":
q = qs.get("q", [""])[0]
data = bsky_get(f"/xrpc/app.bsky.feed.searchPosts?q={urllib.parse.quote(q)}&limit=25")
return self._json(data)

# API tendances
if path == "/api/trending":
data = bsky_get("/xrpc/app.bsky.unspecced.getPopularFeedGenerators?limit=25")
return self._json(data)

# API status
if path == "/api/status":
return self._json({
"engine": "BlueNexus v2.0",
"status": "running",
"port": PORT,
"pages": 5,
"apis": ["profile", "feed", "suggestions", "search/actors", "search/posts", "trending"]
})

self.send_response(404)
self.end_headers()


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True


def main():
os.chdir(str(PAGES))
with Server(("0.0.0.0", PORT), Handler) as httpd:
httpd.serve_forever()


if __name__ == "__main__":
main()
SERVEREOF
}

# ═══════════════════════════════════════════════════════════════
# EXÉCUTION
# ═══════════════════════════════════════════════════════════════

echo "[1/4] Génération CSS..."
generate_css
echo " ✅ CSS généré"

echo "[2/4] Génération pages HTML..."
generate_home
generate_profile_page
generate_search_page
generate_trending_page
generate_about_page
echo " ✅ 5 pages générées"

echo "[3/4] Génération serveur HTTP..."
generate_server
echo " ✅ Serveur généré"

echo "[4/4] Lancement..."
echo ""
echo "════════════════════════════════════════════════════════════"
echo " 🌐 BlueNexus : http://localhost:$PORT"
echo " 📄 Pages : Accueil · Profil · Recherche · Tendances · À propos"
echo " 🔌 APIs : profile · feed · suggestions · search · trending"
echo " 🤖 IA : Nexus locale (bouton 💬 en bas)"
echo "════════════════════════════════════════════════════════════"
echo ""

python3 "$BASE/server.py" "$PORT"
SCRIPT_EOF

chmod +x bluenexus.sh
./bluenexus.sh 8080
