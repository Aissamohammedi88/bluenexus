(r"cache|mémoire",
["Cache actif. Mémoire de session : {hist} messages.",
"Je retiens {hist} interactions."]),
]

self.generics = [
"Compris. Dis-m'en plus.",
"Intéressant. Continue.",
"Je note.",
"Bien reçu.",
