PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
BASE = Path("/tmp/bluenexus")
CACHE_DIR = BASE / "cache"
CACHE_DIR.mkdir(parents=True, exist_ok=True)

SSL_CTX = ssl.create_default_context()
SSL_CTX.check_hostname = False
SSL_CTX.verify_mode = ssl.CERT_NONE

USER_AGENT = "BlueNexus/4.0 (+local)"
CACHE_TTL = 300 # 5 minutes

# ===============================================================================
# MODULE 1 — API BLUESKY
# ===============================================================================

class BlueskyAPI:
"""Client API Bluesky avec cache intelligent"""

BASE_URL = "https://public.api.bsky.app"

def __init__(self):
self.lock = threading.Lock()
self.stats = {"calls": 0, "cache_hits": 0, "errors": 0}

def _cache_path(self, key):
h = hashlib.md5(key.encode()).hexdigest()
return CACHE_DIR / f"{h}.json"

def _cache_get(self, key):
path = self._cache_path(key)
if not path.exists():
return None
try:
age = time.time() - path.stat().st_mtime
if age > CACHE_TTL:
return None
data = json.loads(path.read_text())
with self.lock:
self.stats["cache_hits"] += 1
return data
except Exception:
return None

def _cache_set(self, key, data):
try:
path = self._cache_path(key)
path.write_text(json.dumps(data, ensure_ascii=False))
except Exception:
pass

def get(self, path, use_cache=True):
"""Requête GET vers l'API Bluesky"""
with self.lock:
self.stats["calls"] += 1

if use_cache:
cached = self._cache_get(path)
if cached:
return cached

url = self.BASE_URL + path
try:
req = urllib.request.Request(url, headers={
"User-Agent": USER_AGENT,
"Accept": "application/json"
})
with urllib.request.urlopen(req, timeout=10, context=SSL_CTX) as r:
data = json.loads(r.read().decode("utf-8"))
if use_cache:
self._cache_set(path, data)
return data
except urllib.error.HTTPError as e:
with self.lock:
self.stats["errors"] += 1
return {"error": f"HTTP {e.code}"}
except Exception as e:
with self.lock:
self.stats["errors"] += 1
return {"error": str(e)}

def profile(self, actor):
return self.get("/xrpc/app.bsky.actor.getProfile?actor=" +
urllib.parse.quote(actor))

def feed(self, actor, limit=20):
return self.get("/xrpc/app.bsky.feed.getAuthorFeed?actor=" +
urllib.parse.quote(actor) + "&limit=" + str(limit))

def search_actors(self, q, limit=25):
return self.get("/xrpc/app.bsky.actor.searchActors?q=" +
urllib.parse.quote(q) + "&limit=" + str(limit))

def search_posts(self, q, limit=25):
return self.get("/xrpc/app.bsky.feed.searchPosts?q=" +
urllib.parse.quote(q) + "&limit=" + str(limit))

def suggestions(self, limit=25):
return self.get("/xrpc/app.bsky.actor.getSuggestions?limit=" + str(limit))

def trending(self, limit=25):
return self.get("/xrpc/app.bsky.unspecced.getPopularFeedGenerators?limit=" + str(limit))

def get_stats(self):
with self.lock:
return dict(self.stats)


