"Noté dans ma mémoire.",
"Je traite l'information.",
]

def reply(self, msg):
m = msg.lower().strip()
ctx = {
"hour": datetime.now().strftime("%H:%M:%S"),
"date": datetime.now().strftime("%d/%m/%Y"),
"hist": len(self.history),
}

for pattern, responses in self.rules:
if re.search(pattern, m):
rep = random.choice(responses)
rep = rep.format(**ctx)
self._remember(msg, rep)
return rep

rep = random.choice(self.generics)
self._remember(msg, rep)
return rep

def _remember(self, user, bot):
self.history.append({
"t": datetime.now(timezone.utc).isoformat(),
"u": user,
"b": bot,
})
if len(self.history) > self.max_history:
self.history = self.history[-self.max_history:]

def stats(self):
return {"messages": len(self.history)}


